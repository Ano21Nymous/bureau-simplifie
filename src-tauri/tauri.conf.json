{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bureau Simplifie",
  "version": "0.1.0",
  "identifier": "fr.bureau.simplifie",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bureau Simplifié",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.open-meteo.com https://geocoding-api.open-meteo.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "homepage": "https://github.com/VOTRE-COMPTE/bureau-simplifie",
    "shortDescription": "Bureau simplifié",
    "longDescription": "Un bureau épuré aux gros boutons, pensé pour un usage familial simple et sécurisé."
  }
}
