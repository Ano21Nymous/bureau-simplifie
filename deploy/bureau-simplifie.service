# Variante AVANCÉE : démarrer le kiosque sans aucun gestionnaire de connexion.
#
# C'est la méthode la plus « indétectable » : pas de SDDM, donc aucun écran
# de connexion ne peut apparaître, même une fraction de seconde.
#
# Contreparties :
#   - plus aucune porte de secours graphique ; il faut passer par un autre
#     terminal virtuel (Ctrl+Alt+F3) puis `systemctl stop bureau-simplifie`;
#   - à utiliser seulement quand la configuration SDDM fonctionne déjà.
#
# Installation (remplacer UTILISATEUR) :
#   sudo cp deploy/bureau-simplifie.service /etc/systemd/system/
#   sudo sed -i 's/User=UTILISATEUR/User=mamie/' /etc/systemd/system/bureau-simplifie.service
#   sudo systemctl disable sddm
#   sudo systemctl enable --now bureau-simplifie.service

[Unit]
Description=Bureau Simplifié (kiosque Wayland, sans gestionnaire de connexion)
After=systemd-user-sessions.service
Conflicts=getty@tty1.service
Before=getty@tty2.service

[Service]
Type=simple
User=UTILISATEUR
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_CLASS=user
Environment=XDG_SEAT=seat0
Environment=XDG_VTNR=1
ExecStart=/usr/local/bin/bureau-simplifie-session
Restart=always
RestartSec=3
KillMode=mixed

[Install]
WantedBy=graphical.target
